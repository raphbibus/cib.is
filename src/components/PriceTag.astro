---
// Prominent, interaction-free price block (R4/AC3). Reused near the top CTA and
// inside the Friday section so the 490 € reads as radical transparency in both
// places. The `note` (netto = brutto) is optional so the compact top variant
// can stay tight.
interface Props {
  price: string;
  note?: string;
  class?: string;
}
const { price, note, class: cls = '' } = Astro.props;
---

<div class={`inline-flex flex-col gap-1 border-[3px] border-neon-green bg-surface px-6 py-4 ${cls}`}>
  <span class="font-mono text-xs font-bold uppercase tracking-[0.25em] text-neon-green">
    Festpreis
  </span>
  <span class="font-display text-5xl leading-none text-paper sm:text-6xl">{price}</span>
  {note && <span class="mt-1 max-w-xs text-sm leading-snug text-muted">{note}</span>}
</div>
