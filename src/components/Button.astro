---
// Brutalist button primitive (R5/A4). Renders an <a> when `href` is given,
// otherwise a <button>. `data-variant` is exposed for e2e assertions (T5).
interface Props {
  variant?: 'solid' | 'outline';
  size?: 'md' | 'lg';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  id?: string;
}

const { variant = 'solid', size = 'md', href, type = 'button', class: cls = '', id } = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 font-mono font-bold uppercase tracking-[0.15em] border-[3px] no-underline transition-transform duration-100 hover:-translate-y-0.5';
const variants = {
  solid: 'bg-gradient-accent border-ink text-ink',
  outline: 'bg-transparent border-paper text-paper hover:bg-paper hover:text-ink',
};
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-4 text-base',
};
const className = [base, variants[variant], sizes[size], cls].join(' ');
---

{
  href ? (
    <a href={href} id={id} class={className} data-variant={variant} data-size={size}>
      <slot />
    </a>
  ) : (
    <button type={type} id={id} class={className} data-variant={variant} data-size={size}>
      <slot />
    </button>
  )
}
