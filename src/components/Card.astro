---
// Experience item styled as an album TRACKLIST row (R5/R7/A4) — the music
// identity: each CV station is a "track". Big track number, period as a
// neon stub, poster title, body. Reused as a generic card when `track` is omitted.
interface Props {
  period: string;
  title: string;
  track?: string;
  class?: string;
}

const { period, title, track, class: cls = '' } = Astro.props;
---

<article
  class={`group grid items-start gap-x-5 gap-y-2 border-t-[3px] border-line py-7 transition-colors duration-150 hover:bg-surface sm:gap-x-8 ${track ? 'grid-cols-[auto_1fr]' : 'grid-cols-1'} ${cls}`}
>
  {
    track && (
      <div class="w-[1.6em] font-display text-5xl leading-[0.7] text-ghost transition-colors duration-150 group-hover:text-gradient sm:text-7xl">
        {track}
      </div>
    )
  }
  <div>
    <p class="mb-2 font-mono text-xs font-medium uppercase leading-[0.7] tracking-[0.18em] text-neon-green">
      {period}
    </p>
    <h3 class="text-2xl sm:text-3xl">{title}</h3>
    <p class="mt-3 max-w-2xl leading-relaxed text-muted">
      <slot />
    </p>
  </div>
</article>
