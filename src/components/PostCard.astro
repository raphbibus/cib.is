---
// Blog index list item (R7/R10/AC5/AC7/AC10): title link, German long-form
// date, first-paragraph excerpt. Styled as a tracklist-style row to match the
// site's band/merch system (mirrors Card.astro). No image — by design (R12).
import { formatDate } from '@/lib/blog';

interface Props {
  slug: string;
  title: string;
  date: Date;
  excerpt: string;
  coauthor?: string;
  class?: string;
}

const { slug, title, date, excerpt, coauthor, class: cls = '' } = Astro.props;
const href = `/blog/${slug}`;
---

<article
  class={`group border-t-[3px] border-line py-7 transition-colors duration-150 hover:bg-surface ${cls}`}
>
  <p class="mb-2 font-mono text-xs font-medium uppercase tracking-[0.18em] text-neon-green">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    {coauthor && <span class="text-muted"> · mit {coauthor}</span>}
  </p>
  <h2 class="text-2xl sm:text-3xl">
    <a href={href} class="no-underline transition-colors group-hover:text-gradient">{title}</a>
  </h2>
  <p class="mt-3 max-w-2xl leading-relaxed text-muted">{excerpt}</p>
</article>
