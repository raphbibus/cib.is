---
import MailtoLink from './MailtoLink.astro';

// Footer (R17/AC15 + Epic 4 R7): wordmark + copyright + working obfuscated
// mailto + live legal links. The Impressum/Datenschutz slots are now real
// anchors on every page (go-public requirement).
const year = new Date().getFullYear();
const legalLinks = [
  { label: 'Impressum', href: '/impressum' },
  { label: 'Datenschutz', href: '/datenschutz' },
];
---

<footer class="border-t-[6px] border-paper bg-ink text-paper">
  <div class="mx-auto w-full max-w-6xl px-5 py-12">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <p class="font-mono text-xs uppercase leading-relaxed tracking-[0.18em] text-muted">
        © {year} Ralph Cibis · Organisations-Punk<br />
        Zuhause in der Metropolregion Nürnberg · deutschlandweit im Einsatz
      </p>

      <nav aria-label="Footer" class="flex flex-col gap-3 sm:items-end">
        <MailtoLink
          class="font-mono text-sm font-medium uppercase tracking-[0.15em] text-paper underline underline-offset-4 hover:text-neon-green"
        >
          E-Mail schreiben
        </MailtoLink>
        <ul class="flex gap-5">
          {/* Live link — keeps the blog discoverable where the header nav is hidden (mobile). */}
          <li>
            <a
              href="/blog"
              class="font-mono text-xs uppercase tracking-[0.15em] text-paper underline underline-offset-4 hover:text-neon-green"
            >
              Blog
            </a>
          </li>
          {
            legalLinks.map(({ label, href }) => (
              <li>
                <a
                  href={href}
                  class="font-mono text-xs uppercase tracking-[0.15em] text-paper underline underline-offset-4 hover:text-neon-green"
                >
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </div>
</footer>
