---
import BaseHead from './BaseHead.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { MAILTO_KEY } from '@/lib/mailto';
import type { OgType } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: OgType;
}

const { title, description, ogImage, ogType } = Astro.props;
---

<!doctype html>
<html lang="de">
  <head>
    <BaseHead title={title} description={description} ogImage={ogImage} ogType={ogType} />
  </head>
  <body class="min-h-screen bg-ink text-paper font-body antialiased overflow-x-hidden">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:bg-neon-green focus:px-4 focus:py-2 focus:font-mono focus:font-bold focus:text-ink"
    >
      Zum Inhalt springen
    </a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    {/* Single shared, dependency-free inline decoder for every obfuscated
        mailto link (A10). No bundle, no island — assembles the address on
        first interaction (pointerdown / focus), keeping AC2 + AC6. */}
    <script is:inline define:vars={{ key: MAILTO_KEY }}>
      (function () {
        var dec = function (t) {
          var r = atob(t), o = '';
          for (var i = 0; i < r.length; i++) o += String.fromCharCode(r.charCodeAt(i) ^ key);
          return o;
        };
        var reveal = function (a) {
          if (!a.dataset.eml) return;
          var s = a.dataset.subj;
          a.href = 'mailto:' + dec(a.dataset.eml) + (s ? '?subject=' + encodeURIComponent(dec(s)) : '');
        };
        document.querySelectorAll('a[data-eml]').forEach(function (a) {
          var go = function () { reveal(a); };
          a.addEventListener('pointerdown', go); // mouse + touch + pen, before click
          a.addEventListener('focus', go); // keyboard
        });
      })();
    </script>
  </body>
</html>
