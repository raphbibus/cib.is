---
import Layout from '@/components/Layout.astro';
import Section from '@/components/Section.astro';
import Prose from '@/components/Prose.astro';
import Button from '@/components/Button.astro';
import { offers } from '@/content/offers';

// Native no-JS success page (TD1 — progressive enhancement). The contact form's
// `action` target: when JS is off the form POSTs to Netlify and lands here.
// Shares the inline-success copy (R11/AC10) so the two never drift.
const { confirmation } = offers;
---

<Layout
  title="Danke · cib.is"
  description="Ihre Anfrage ist angekommen. Ralph Cibis meldet sich persönlich, in der Regel binnen 2 Werktage."
>
  <Section id="danke" kicker="Anfrage gesendet" title={confirmation.headline}>
    <Prose>
      <p>{confirmation.body}</p>
    </Prose>
    <div class="mt-8">
      <Button href="/angebot" variant="primary" size="lg">← Zurück zum Angebot</Button>
    </div>
  </Section>
</Layout>
