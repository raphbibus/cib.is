---
import Layout from '@/components/Layout.astro';
import Prose from '@/components/Prose.astro';
import PostCta from '@/components/PostCta.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '@/lib/blog';
import { firstParagraph } from '@/lib/excerpt';

// /blog/<slug> — one static page per post (R3/R18/AC10). Title comes from the
// loader-derived frontmatter and is the page's single <h1>; the body H1 was
// stripped at build (no duplicate — AC7). Solo posts show no byline; the collab
// post shows "mit Domi" (R9). Per-post SEO/OG meta uses og:type=article with a
// description derived from the first paragraph (R15/TD4); noindex stays on.
export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, coauthor } = post.data;
const description = firstParagraph(post.body ?? '');
---

<Layout
  title={`${title} — Blog · Ralph Cibis`}
  description={description}
  ogType="article"
>
  <article class="border-t-[3px] border-line py-(--spacing-section)">
    <div class="mx-auto w-full max-w-6xl px-5">
      <header class="mb-10">
        <p class="mb-4 font-mono text-xs font-medium uppercase tracking-[0.18em] text-neon-green">
          <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
          {coauthor && <span class="text-muted"> · mit {coauthor}</span>}
        </p>
        <h1 class="max-w-4xl text-[clamp(2rem,6vw,4.5rem)]">{title}</h1>
      </header>

      <Prose>
        <Content />
      </Prose>

      <PostCta />
    </div>
  </article>
</Layout>
